# ── Copy this file to .env and fill in your values ────────────────────────────
# Used by docker-compose.yml at runtime.

# ── Backend ───────────────────────────────────────────────────────────────────
JWT_SECRET=your-very-long-random-secret-here
PAYPACK_CLIENT_ID=your-paypack-client-id
PAYPACK_CLIENT_SECRET=your-paypack-client-secret

# URL the backend allows as CORS origin (update when deploying)
CLIENT_URL=http://localhost:3000

# ── Frontend (baked into the Vite build — rebuild image if these change) ──────
VITE_API_URL=http://localhost:5000

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
